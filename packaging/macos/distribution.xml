<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Avel EQ @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>

    <choice id="vst3" title="Avel EQ VST3"
            description="REAPER, Ableton Live, Cubase, Studio One, Bitwig, FL Studio">
        <pkg-ref id="com.avel.eq.vst3"/>
    </choice>
    <choice id="au" title="Avel EQ Audio Unit"
            description="Logic Pro, GarageBand, MainStage">
        <pkg-ref id="com.avel.eq.au"/>
    </choice>

    <pkg-ref id="com.avel.eq.vst3" version="@VERSION@" onConclusion="none">AvelEQ-VST3.pkg</pkg-ref>
    <pkg-ref id="com.avel.eq.au" version="@VERSION@" onConclusion="none">AvelEQ-AU.pkg</pkg-ref>
</installer-gui-script>
