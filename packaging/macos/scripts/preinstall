#!/bin/bash
# Remove an older Avel EQ of the same kind so the new one replaces it cleanly.
# $1 is the path of the component package being installed.
if [ "$(basename "$1")" = "AvelEQ-VST3.pkg" ]; then
    rm -rf "/Library/Audio/Plug-Ins/VST3/Avel EQ.vst3"
elif [ "$(basename "$1")" = "AvelEQ-AU.pkg" ]; then
    rm -rf "/Library/Audio/Plug-Ins/Components/Avel EQ.component"
fi
exit 0
